# Application
NODE_ENV=development
PORT=3000

# Databases
MONGO_URI=mongodb://localhost:27017/agada
POSTGRES_URI=postgresql://agada:agada123@localhost:5432/agada_auth
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY=15m
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
REFRESH_TOKEN_EXPIRY=7d

# ABDM Integration
ABDM_SANDBOX_URL=https://sandbox.abdm.gov.in
ABDM_CLIENT_ID=your_client_id
ABDM_CLIENT_SECRET=your_client_secret
ABDM_FHIR_URL=https://sandbox.abdm.gov.in/fhir

# eSanjeevani
ESANJEEVANI_API_URL=https://api.esanjeevani.in
ESANJEEVANI_API_KEY=your_api_key

# RCH Portal
RCH_API_URL=https://rch.maharashtra.gov.in/api
RCH_API_KEY=your_api_key

# HMIS
HMIS_API_URL=https://hmis.mohfw.gov.in/api
HMIS_API_KEY=your_api_key

# SMS Gateway
SMS_GATEWAY_URL=https://api.smsgateway.in
SMS_GATEWAY_API_KEY=your_api_key
SMS_SENDER_ID=AGADA

# AWS
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
S3_BUCKET=agada-platform

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:3000

# Service URLs (for internal communication)
AUTH_SERVICE_URL=http://localhost:3001
PATIENT_SERVICE_URL=http://localhost:3002
TRIAGE_SERVICE_URL=http://localhost:3003
REFERRAL_SERVICE_URL=http://localhost:3004
TELEMED_SERVICE_URL=http://localhost:3005
MEDICINE_SERVICE_URL=http://localhost:3006
DIAGNOSTIC_SERVICE_URL=http://localhost:3007
QUEUE_SERVICE_URL=http://localhost:3008
NOTIFICATION_SERVICE_URL=http://localhost:3009
ANALYTICS_SERVICE_URL=http://localhost:3010
CARE_GRAPH_SERVICE_URL=http://localhost:3011
SYNC_SERVICE_URL=http://localhost:3012
INTEGRATION_GATEWAY_URL=http://localhost:3013


# PORTs
AUTH_SERVICE_PORT=3001
PATIENT_SERVICE_PORT=3002
TRIAGE_SERVICE_PORT=3003
REFERRAL_SERVICE_PORT=3004
TELEMED_SERVICE_PORT=3005
MEDICINE_SERVICE_PORT=3006
