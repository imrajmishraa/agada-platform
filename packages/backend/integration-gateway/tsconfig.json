{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@agada/shared": ["../../shared/src"],
      "@agada/shared/*": ["../../shared/src/*"],
      "@agada/types": ["../../shared/src/types"],
      "@agada/utils": ["../../shared/src/utils"],
      "@agada/constants": ["../../shared/src/constants"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
