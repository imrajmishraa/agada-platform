{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@agada/shared": ["./packages/shared/src"],
      "@agada/shared/*": ["./packages/shared/src/*"],
      "@agada/types": ["./packages/shared/src/types"],
      "@agada/utils": ["./packages/shared/src/utils"],
      "@agada/constants": ["./packages/shared/src/constants"]
    }
  },
  "exclude": ["node_modules", "dist", "build"]
}